{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and balance information",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "wallet": {
          "type": "object",
          "properties": {
            "deposit": { "type": "number" },
            "winnings": { "type": "number" },
            "bonus": { "type": "number" }
          }
        },
        "isKycVerified": { "type": "boolean" },
        "isAdmin": { "type": "boolean" },
        "isBanned": { "type": "boolean" },
        "stats": {
          "type": "object",
          "properties": {
            "matchesPlayed": { "type": "number" },
            "totalWins": { "type": "number" },
            "totalKills": { "type": "number" },
            "totalWinnings": { "type": "number" }
          }
        },
        "referredBy": { "type": "string" },
        "referralClaimed": { "type": "boolean" },
        "deviceId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["username", "email", "wallet"]
    },
    "AppSettings": {
      "title": "App Settings",
      "description": "Global application configuration, branding, manual payment, and limits",
      "type": "object",
      "properties": {
        "appName": { "type": "string" },
        "appLogoUrl": { "type": "string" },
        "upiId": { "type": "string" },
        "qrCodeUrl": { "type": "string" },
        "manualPayment": { "type": "object" },
        "limits": {
          "type": "object",
          "properties": {
            "minDeposit": { "type": "number" },
            "maxDeposit": { "type": "number" },
            "minWithdraw": { "type": "number" },
            "maxWithdraw": { "type": "number" }
          }
        },
        "announcements": { "type": "array" },
        "referral": {
          "type": "object",
          "properties": {
            "baseUrl": { "type": "string" },
            "perReferralReward": { "type": "number" },
            "rewardType": { "type": "string", "enum": ["deposit", "bonus", "both"] },
            "depositPercentage": { "type": "number" },
            "bonusPercentage": { "type": "number" },
            "newUserReward": { "type": "number" }
          }
        },
        "support": {
          "type": "object",
          "properties": {
            "whatsapp": { "type": "string" },
            "telegram": { "type": "string" },
            "email": { "type": "string" }
          }
        }
      }
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Ticker announcement item displayed on Home screen",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "link": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "isActive"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app and broadcast notification record",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "audience": { "type": "string", "enum": ["all", "user", "match"] },
        "targetUserId": { "type": "string" },
        "targetMatchId": { "type": "string" },
        "actionPage": { "type": "string" },
        "readBy": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "message"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transaction record for deposits, withdrawals, and contest entries/winnings",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["deposit", "withdraw", "withdrawal", "win", "entry", "refund"] },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["completed", "pending", "failed"] },
        "utr": { "type": "string" },
        "upiId": { "type": "string" },
        "matchId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "amount", "status", "createdAt"]
    },
    "Game": {
      "title": "Game",
      "description": "Game arena category (e.g., FREE FIRE, BGMI)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "players": { "type": "number" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["title", "image"]
    },
    "Tournament": {
      "title": "Tournament",
      "description": "Match or tournament details",
      "type": "object",
      "properties": {
        "gameId": { "type": "string" },
        "modeId": { "type": "string" },
        "section": { "type": "string" },
        "title": { "type": "string" },
        "image": { "type": "string" },
        "entryFee": { "type": "number" },
        "prizePool": { "type": "number" },
        "perKill": { "type": "number" },
        "time": { "type": "string" },
        "totalSlots": { "type": "number" },
        "filledSlots": { "type": "number" },
        "map": { "type": "string" },
        "perspective": { "type": "string" },
        "status": { "type": "string", "enum": ["upcoming", "ongoing", "completed"] }
      },
      "required": ["gameId", "title", "entryFee", "totalSlots"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Promotional slider and single bottom banner",
      "type": "object",
      "properties": {
        "imageUrl": { "type": "string" },
        "redirectUrl": { "type": "string" },
        "type": { "type": "string", "enum": ["main", "offer", "freefire", "bottom"] },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["imageUrl", "type", "order"]
    },
    "Registration": {
      "title": "Registration",
      "description": "A user's registration for a specific tournament",
      "type": "object",
      "properties": {
        "tournamentId": { "type": "string" },
        "userId": { "type": "string" },
        "ign": { "type": "string" },
        "slot": { "type": "number" },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tournamentId", "userId", "ign", "slot"]
    },
    "GameRule": {
      "title": "Game Rule",
      "description": "Rules for different game types",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "rules": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["type", "rules"]
    },
    "GameMode": {
      "title": "Game Mode",
      "description": "Dynamic tournament mode configuration inside a game",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "gameId": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "image": { "type": "string" },
        "category": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["id", "gameId", "title", "image"]
    },
    "PaymentGateway": {
      "title": "Payment Gateway",
      "description": "Configuration for a single payment gateway",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "apiKey": { "type": "string" },
        "secretKey": { "type": "string" },
        "merchantId": { "type": "string" },
        "webhookSecret": { "type": "string" },
        "upiId": { "type": "string" },
        "isActive": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "isActive"]
    },
    "Staff": {
      "title": "Staff",
      "description": "Staff member access control and role assignment",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["FINANCE_MANAGER", "TOURNAMENT_ORGANIZER", "ALL"] },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "assignedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "username", "email", "role", "status"]
    },
    "MediaAsset": {
      "title": "Media Asset",
      "description": "Central media and image storage item for banners, games, and tournament modes",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "url": { "type": "string" },
        "category": { "type": "string", "enum": ["banner", "game", "mode", "general"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "uploadedBy": { "type": "string" },
        "uploadedByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "url", "category"]
    }
  },
  "firestore": {
    "/paymentSettings/{gatewayId}": {
      "schema": "PaymentGateway",
      "description": "Configurations for multiple payment gateways"
    },
    "/gameModes/{modeId}": {
      "schema": "GameMode",
      "description": "Dynamic game mode configurations"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Private user profiles"
    },
    "/games/{gameId}": {
      "schema": "Game",
      "description": "Public game categories"
    },
    "/matches/{matchId}": {
      "schema": "Tournament",
      "description": "Publicly viewable matches"
    },
    "/tournaments/{tournamentId}": {
      "schema": "Tournament",
      "description": "Publicly viewable matches"
    },
    "/banners/{bannerId}": {
      "schema": "Banner",
      "description": "Home slider and bottom banners"
    },
    "/registrations/{registrationId}": {
      "schema": "Registration",
      "description": "Match entries"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial transaction history (deposits, withdrawals, contest entries)"
    },
    "/meta/counters": {
      "schema": "object",
      "description": "System-wide counters"
    },
    "/gameRules/{ruleId}": {
      "schema": "GameRule",
      "description": "Rules for various match types"
    },
    "/appSettings/{settingId}": {
      "schema": "AppSettings",
      "description": "Global application configuration and announcements"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "In-app and broadcast notification messages"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Public ticker announcements"
    },
    "/staff/{staffId}": {
      "schema": "Staff",
      "description": "Admin-assigned staff roles and permissions"
    },
    "/mediaAssets/{assetId}": {
      "schema": "MediaAsset",
      "description": "Central media and image storage collection for banners, games, and tournament modes"
    }
  }
}
